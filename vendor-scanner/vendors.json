{
  "_comment": "Vendor signatures are intentionally language-agnostic: import_patterns/class_names use dotted-path style found in most languages, endpoints/env_key_patterns/key_prefixes are plain strings. A future non-Python parser (JS/TS, Go, etc.) can consume this same file.",

  "vendors": [
    {
      "name": "OpenAI",
      "import_patterns": ["openai"],
